# Copy to .env.local (gitignored) and adjust paths for your lab controller.
#
#   cp .env.local.example .env.local
#
# Used by ./fleet_lab.sh

# Private key for fleet SSH (OpenSSH format)
FSTEK_SSH_KEY=$HOME/.ssh/id_ed25519

# Optional overrides
# FSTEK_FLEET_CLASS=K3
# FSTEK_REMOTE_REPO=/opt/fstek-checks-2026
# FSTEK_BATCH_ID=lab-manual
